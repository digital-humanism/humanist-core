# Normalize text files in the repository.
* text=auto

# Keep source and documentation files on LF across platforms.
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Shell scripts should always use LF.
*.sh    text eol=lf

# Windows command scripts may use CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf